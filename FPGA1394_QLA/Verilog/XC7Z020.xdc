################################################################################
# IEEE-1394 (Firewire) Interface
################################################################################

# port io standard
set_property IOSTANDARD LVCMOS33 [get_ports {ctl[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {ctl[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {data[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {data[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {data[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {data[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {data[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {data[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {data[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {data[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports lreq]
set_property IOSTANDARD LVCMOS33 [get_ports reset_phy]
set_property IOSTANDARD LVCMOS33 [get_ports clk1394]

# port package pin
set_property PACKAGE_PIN F20 [get_ports {ctl[0]}]
set_property PACKAGE_PIN F19 [get_ports {ctl[1]}]
set_property PACKAGE_PIN L17 [get_ports {data[0]}]
set_property PACKAGE_PIN J16 [get_ports {data[1]}]
set_property PACKAGE_PIN E18 [get_ports {data[2]}]
set_property PACKAGE_PIN E17 [get_ports {data[3]}]
set_property PACKAGE_PIN H17 [get_ports {data[4]}]
set_property PACKAGE_PIN G19 [get_ports {data[5]}]
set_property PACKAGE_PIN D19 [get_ports {data[6]}]
set_property PACKAGE_PIN D18 [get_ports {data[7]}]
set_property PACKAGE_PIN M18 [get_ports lreq]
set_property PACKAGE_PIN D20 [get_ports reset_phy]
set_property PACKAGE_PIN H16 [get_ports clk1394]

# port PULLUP
set_property PULLUP true [get_ports {ctl[0]}]
set_property PULLUP true [get_ports {ctl[1]}]
set_property PULLUP true [get_ports {data[0]}]
set_property PULLUP true [get_ports {data[1]}]
set_property PULLUP true [get_ports {data[2]}]
set_property PULLUP true [get_ports {data[3]}]
set_property PULLUP true [get_ports {data[4]}]
set_property PULLUP true [get_ports {data[5]}]
set_property PULLUP true [get_ports {data[6]}]
set_property PULLUP true [get_ports {data[7]}]

# port clk1394
create_clock -period 20.345 -name CLK_IN1394x -waveform {0.000 10.1725} [get_ports clk1394]
set_input_jitter CLK_IN1394x 0.1  # ns (100 ps)

################################################################################
# LED Output
################################################################################

# port io standard
set_property IOSTANDARD LVCMOS33 [get_ports LED]

# port package pin (was N18 in V3.0)
set_property PACKAGE_PIN U13 [get_ports LED]

################################################################################
# Board ID
################################################################################

# port io standard
set_property IOSTANDARD LVCMOS33 [get_ports {wenid[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {wenid[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {wenid[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {wenid[3]}]

# port package pin
set_property PACKAGE_PIN A20 [get_ports {wenid[0]}]
set_property PACKAGE_PIN B20 [get_ports {wenid[1]}]
set_property PACKAGE_PIN B19 [get_ports {wenid[2]}]
set_property PACKAGE_PIN C20 [get_ports {wenid[3]}]

# port pullup
set_property PULLUP true [get_ports {wenid[0]}]
set_property PULLUP true [get_ports {wenid[1]}]
set_property PULLUP true [get_ports {wenid[2]}]
set_property PULLUP true [get_ports {wenid[3]}]

################################################################################
# Ethernet PHYs
################################################################################

# port io standard
set_property IOSTANDARD LVCMOS33 [get_ports E1_RSTn]
set_property IOSTANDARD LVCMOS33 [get_ports E2_RSTn]
set_property IOSTANDARD LVCMOS33 [get_ports E1_IRQn]
set_property IOSTANDARD LVCMOS33 [get_ports E2_IRQn]

set_property IOSTANDARD LVCMOS33 [get_ports E1_MDIO_C]
set_property IOSTANDARD LVCMOS33 [get_ports E2_MDIO_C]
set_property IOSTANDARD LVCMOS33 [get_ports E1_MDIO_D]
set_property IOSTANDARD LVCMOS18 [get_ports E2_MDIO_D]

set_property IOSTANDARD LVCMOS18 [get_ports E1_TxCLK]
set_property IOSTANDARD LVCMOS18 [get_ports E2_TxCLK]
set_property IOSTANDARD LVCMOS18 [get_ports E1_TxEN]
set_property IOSTANDARD LVCMOS18 [get_ports E2_TxEN]
set_property IOSTANDARD LVCMOS18 [get_ports {E1_TxD[3]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E1_TxD[2]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E1_TxD[1]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E1_TxD[0]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E2_TxD[3]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E2_TxD[2]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E2_TxD[1]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E2_TxD[0]}]

set_property IOSTANDARD LVCMOS18 [get_ports E1_RxCLK]
set_property IOSTANDARD LVCMOS18 [get_ports E2_RxCLK]
set_property IOSTANDARD LVCMOS18 [get_ports E1_RxVAL]
set_property IOSTANDARD LVCMOS18 [get_ports E2_RxVAL]
set_property IOSTANDARD LVCMOS18 [get_ports {E1_RxD[3]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E1_RxD[2]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E1_RxD[1]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E1_RxD[0]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E2_RxD[3]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E2_RxD[2]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E2_RxD[1]}]
set_property IOSTANDARD LVCMOS18 [get_ports {E2_RxD[0]}]

# port package pin
set_property PACKAGE_PIN P20 [get_ports E1_RSTn]
set_property PACKAGE_PIN N20 [get_ports E2_RSTn]
set_property PACKAGE_PIN R16 [get_ports E1_IRQn]
set_property PACKAGE_PIN U14 [get_ports E2_IRQn]

set_property PACKAGE_PIN R19 [get_ports E1_MDIO_C]
set_property PACKAGE_PIN P19 [get_ports E2_MDIO_C]
set_property PACKAGE_PIN T20 [get_ports E1_MDIO_D]
set_property PACKAGE_PIN W6 [get_ports E2_MDIO_D]

set_property PACKAGE_PIN V11 [get_ports E1_TxCLK]
set_property PACKAGE_PIN Y6 [get_ports E2_TxCLK]
set_property PACKAGE_PIN W10 [get_ports E1_TxEN]
set_property PACKAGE_PIN U7 [get_ports E2_TxEN]
set_property PACKAGE_PIN Y13 [get_ports {E1_TxD[3]}]
set_property PACKAGE_PIN Y12 [get_ports {E1_TxD[2]}]
set_property PACKAGE_PIN W11 [get_ports {E1_TxD[1]}]
set_property PACKAGE_PIN Y11 [get_ports {E1_TxD[0]}]
set_property PACKAGE_PIN U10 [get_ports {E2_TxD[3]}]
set_property PACKAGE_PIN V10 [get_ports {E2_TxD[2]}]
set_property PACKAGE_PIN U9 [get_ports {E2_TxD[1]}]
set_property PACKAGE_PIN U8 [get_ports {E2_TxD[0]}]

set_property PACKAGE_PIN Y7 [get_ports E1_RxCLK]
set_property PACKAGE_PIN T9 [get_ports E2_RxCLK]
set_property PACKAGE_PIN V8 [get_ports E1_RxVAL]
set_property PACKAGE_PIN T5 [get_ports E2_RxVAL]
set_property PACKAGE_PIN W9 [get_ports {E1_RxD[3]}]
set_property PACKAGE_PIN Y9 [get_ports {E1_RxD[2]}]
set_property PACKAGE_PIN W8 [get_ports {E1_RxD[1]}]
set_property PACKAGE_PIN Y8 [get_ports {E1_RxD[0]}]
set_property PACKAGE_PIN V7 [get_ports {E2_RxD[3]}]
set_property PACKAGE_PIN U5 [get_ports {E2_RxD[2]}]
set_property PACKAGE_PIN V6 [get_ports {E2_RxD[1]}]
set_property PACKAGE_PIN V5 [get_ports {E2_RxD[0]}]

# port PULLUP
set_property PULLUP true [get_ports E1_RSTn]
set_property PULLUP true [get_ports E2_RSTn]
set_property PULLUP true [get_ports E1_IRQn]
set_property PULLUP true [get_ports E2_IRQn]

# port SLEW
# Xilinx GMII to RGMII v1.00a Product Brief (PB014) recommends SLEW=FAST for
# all Tx signals
set_property SLEW FAST [get_ports E1_TxCLK]
set_property SLEW FAST [get_ports E2_TxCLK]
set_property SLEW FAST [get_ports E1_TxEN]
set_property SLEW FAST [get_ports E2_TxEN]
set_property SLEW FAST [get_ports {E1_TxD[3]}]
set_property SLEW FAST [get_ports {E1_TxD[2]}]
set_property SLEW FAST [get_ports {E1_TxD[1]}]
set_property SLEW FAST [get_ports {E1_TxD[0]}]
set_property SLEW FAST [get_ports {E2_TxD[3]}]
set_property SLEW FAST [get_ports {E2_TxD[2]}]
set_property SLEW FAST [get_ports {E2_TxD[1]}]
set_property SLEW FAST [get_ports {E2_TxD[0]}]

# port DRIVE
# Xilinx GMII to RGMII v1.00a Product Brief (PB014) recommends DRIVE=24
# for all Tx signals except TxCLK.
# TODO: Why DRIVE=24 for E1_TxCLK
set_property DRIVE 24 [get_ports E1_TxCLK]
#set_property DRIVE 24 [get_ports E2_TxCLK]
set_property DRIVE 24 [get_ports E1_TxEN]
set_property DRIVE 24 [get_ports E2_TxEN]
set_property DRIVE 24 [get_ports {E1_TxD[3]}]
set_property DRIVE 24 [get_ports {E1_TxD[2]}]
set_property DRIVE 24 [get_ports {E1_TxD[1]}]
set_property DRIVE 24 [get_ports {E1_TxD[0]}]
set_property DRIVE 24 [get_ports {E2_TxD[3]}]
set_property DRIVE 24 [get_ports {E2_TxD[2]}]
set_property DRIVE 24 [get_ports {E2_TxD[1]}]
set_property DRIVE 24 [get_ports {E2_TxD[0]}]

# -----------------------------------------------------------
# Input clocks
# Following assumes 1GB, where RxCLK is 125 MHz
# -----------------------------------------------------------
create_clock -period 8.000 -name E1_RxCLK -waveform {0.000 4.000} [get_ports E1_RxCLK]
create_clock -period 8.000 -name E2_RxCLK -waveform {0.000 4.000} [get_ports E2_RxCLK]
